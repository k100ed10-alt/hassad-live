rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /students/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /teachers/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /assignments/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /live_sessions/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /lessons/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /submissions/{id} {
      allow read, write: if request.auth != null;
    }
    match /messages/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
